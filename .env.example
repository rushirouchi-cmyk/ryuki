# PostgreSQL connection string (Supabase or any Postgres 14+)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/career_routing

# Public origin used when building QR code URLs (/d/{token})
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 32+ char secret used to hash visitor fingerprints and sign candidate magic links
APP_SECRET=change-me-to-a-long-random-string

# Password for every seeded demo account (dev only)
SEED_PASSWORD=password123
