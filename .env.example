# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Leave DATABASE_URL empty to use the embedded PGlite database (./data/pglite).
# No PostgreSQL server is required for local development or tests.
#
# To use a real PostgreSQL / Supabase instance, set a connection string:
#   DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ryuki
#   DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT].supabase.co:5432/postgres
DATABASE_URL=

# Directory used by the embedded PGlite database (ignored when DATABASE_URL is set).
PGLITE_DATA_DIR=./data/pglite

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# Secret used to sign session cookies. Generate with: openssl rand -hex 32
AUTH_SECRET=dev-only-insecure-secret-change-me-0000000000000000

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
# Base URL used when rendering QR codes for a sales shift.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Password assigned to every seeded demo account.
SEED_PASSWORD=password123

# Business timezone. Defaults to Asia/Tokyo; override only for another market.
TZ=Asia/Tokyo
