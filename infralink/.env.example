# ============================================================================
# INFRALINK AI Talent Intelligence System — 環境変数テンプレート
# このファイルをコピーして .env.local (または .env) を作成してください。
# 実際のキー・パスワードは絶対にコミットしないでください (§41)。
# ============================================================================

# ---- Database ---------------------------------------------------------------
# MVP 既定: SQLite (外部依存なしで動作)
DATABASE_URL="file:./data/dev.db"
# PostgreSQL を使う場合:
#   npm run db:use-postgres  でスキーマの provider を切り替えてから設定
# DATABASE_URL="postgresql://user:password@localhost:5432/infralink?schema=public"

# ---- Auth -------------------------------------------------------------------
# 32 文字以上のランダム文字列。`openssl rand -base64 48` などで生成。
AUTH_SECRET="change-me-to-a-long-random-string-at-least-32-chars"
SESSION_MAX_AGE_HOURS="12"

# ---- AI Provider (§40) ------------------------------------------------------
# mock | anthropic | openai | gemini
AI_PROVIDER="mock"
AI_MODEL="claude-sonnet-5"
ANTHROPIC_API_KEY=""
OPENAI_API_KEY=""
GEMINI_API_KEY=""

# ---- Web Search Provider (§13/§39) ------------------------------------------
# mock | brave | serper | tavily
SEARCH_PROVIDER="mock"
SEARCH_API_KEY=""

# ---- Notification (§30) -----------------------------------------------------
# console | smtp | slack
NOTIFICATION_PROVIDER="console"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="noreply@infralink.example.co.jp"
SLACK_WEBHOOK_URL=""

# ---- Data Source Adapter (§4) -----------------------------------------------
# mock | sheets | porters
DATA_SOURCE="mock"

# PORTERS API (Phase 2)
PORTERS_API_BASE_URL=""
PORTERS_API_KEY=""
PORTERS_TENANT_ID=""

# Google Sheets (MVP)
GOOGLE_SHEETS_SPREADSHEET_ID=""
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
# 改行を \n にエスケープした PEM 文字列
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=""

# ---- Scheduled Jobs (§52) ---------------------------------------------------
# /api/cron/* を外部スケジューラから叩く際の共有シークレット
CRON_SECRET="change-me-cron-secret"
